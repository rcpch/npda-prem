msgid "q31.child.title"
msgstr "Have you ever been excluded from any of the below activities because of your diabetes?"

#: submissions/sections.py:336
msgid "q31.parent.title"
msgstr "Has your child ever been excluded from any of the below activities because of their diabetes?"

#: submissions/sections.py:338
msgid "q31.hint"
msgstr "Select all that apply"

#: submissions/sections.py:346
msgid "q32.child.title"
msgstr "Do you feel that your diabetes affects your performance in school/home education?"

#: submissions/sections.py:347
msgid "q32.parent.title"
msgstr "Do you feel that your child's diabetes affects their performance in school/home education?"

#: submissions/sections.py:356
msgid "q33.child.title"
msgstr "Do your teachers have a good understanding of how diabetes can affect learning?"

#: submissions/sections.py:357
msgid "q33.parent.title"
msgstr "Do your child's teachers have a good understanding of how diabetes can affect learning?"

#: submissions/sections.py:359
msgid "q33.hint"
msgstr "E.g. When blood glucose is too high or low, it may affect concentration or memory."

#: submissions/sections.py:367
msgid "q34.child.title"
msgstr "Have you ever been offered any reasonable adjustments because of your diabetes?"

#: submissions/sections.py:368
msgid "q34.parent.title"
msgstr "Has your child ever been offered any reasonable adjustments because of their diabetes?"

#: submissions/sections.py:370
msgid "q34.hint"
msgstr "(e.g. additional time in exams, snacks or drinks during class, fast passes for lunch queues)"

