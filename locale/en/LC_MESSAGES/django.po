msgid "q17.child.title"
msgstr "How do you administer insulin in school?"

#: submissions/sections.py:181
msgid "q17.parent.title"
msgstr "How does your child administer insulin in school?"

#: submissions/sections.py:183
msgid "q17.hint"
msgstr "Select all that apply"

#: submissions/sections.py:191
msgid "q18.child.title"
msgstr "How do you monitor blood glucose levels in school?"

#: submissions/sections.py:192
msgid "q18.parent.title"
msgstr "How does your child monitor blood glucose levels in school?"

#: submissions/sections.py:194
msgid "q18.hint"
msgstr "Select all that apply"

#: submissions/sections.py:202
msgid "q19.parent.title"
msgstr "Can you follow/monitor your child's blood glucose remotely?"

#: submissions/sections.py:211
msgid "q20.parent.title"
msgstr "Are you able to contact your child's school during the day if you are concerned about their diabetes?"

#: submissions/sections.py:220
msgid "q21.child.title"
msgstr "If you use a smartphone or smartwatch to manage your diabetes, are you able to use it during lesson time at school?"

#: submissions/sections.py:221
msgid "q21.parent.title"
msgstr "If your child uses a smartphone or smartwatch to manage their diabetes, are they able to use it during lesson time at school?"

#: submissions/sections.py:230
msgid "q22.child.title"
msgstr "Are you offered a private room at school for diabetes care, even if you don't use it?"

#: submissions/sections.py:231
msgid "q22.parent.title"
msgstr "Is your child offered a private room at school for diabetes care, even if they don't use it?"

#: submissions/sections.py:233
msgid "q22.hint"
msgstr "E.g. For administering insulin, checking blood glucose, changing pump set, or anything else related to diabetes care"

#: submissions/sections.py:241
msgid "q23.child.title"
msgstr "Are you allowed to manage diabetes in the classroom if required?"

#: submissions/sections.py:242
msgid "q23.parent.title"
msgstr "Is your child allowed to manage diabetes in the classroom if required?"

#: submissions/sections.py:244
msgid "q23.hint"
msgstr "This includes checking blood glucose or giving insulin."

#: submissions/sections.py:252
msgid "q24.child.title"
msgstr "Is there a trained member of staff at school who can help you with diabetes management?"

#: submissions/sections.py:253
msgid "q24.parent.title"
msgstr "Is there a trained member of staff at school who can help your child with diabetes management?"

#: submissions/sections.py:255
msgid "q24.hint"
msgstr "This includes checking blood glucose, administering insulin, and providing support in emergencies. This training should be provided by the diabetes team."

#: submissions/sections.py:263
msgid "q25.child.title"
msgstr "Does your school provide enough information about school meals for carb-counting?"

#: submissions/sections.py:264
msgid "q25.parent.title"
msgstr "Does your child's school provide enough information about school meals for carb-counting?"

#: submissions/sections.py:266
msgid "q25.hint"
msgstr "This includes information about carbohydrate content and portion sizes to help you/your child adjust insulin to match."

#: submissions/sections.py:275
#: submissions/templates/submissions/_shared_education_impact.html:8
msgid "Impact on Education"
msgstr ""

#: submissions/sections.py:276
msgid "education_impact.introduction"
msgstr "This section asks about how your/your child's diabetes impacts your/their education."

#: submissions/sections.py:283
msgid "q26.child.title"
msgstr "In the past year, how many times have you missed one or more lessons in any given day to attend diabetes-related hospital appointments?"

#: submissions/sections.py:284
msgid "q26.parent.title"
msgstr "In the past year, how many times has your child missed one or more lessons in any given day to attend diabetes-related hospital appointments?"

#: submissions/sections.py:286
msgid "q26.hint"
msgstr "This could include routine appointments for the diabetes clinic or other appointments with a PDSN, dietitian, psychologist etc. (not inpatient hospital stays)"

