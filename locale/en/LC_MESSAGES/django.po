msgid "q28.child.title"
msgstr "Has your school attendance records been negatively impacted by attending diabetes clinic appointments?"

#: submissions/sections.py:305
msgid "q28.parent.title"
msgstr "Has your child's school attendance records been negatively impacted by attending diabetes clinic appointments?"

#: submissions/sections.py:307
msgid "q28.hint"
msgstr "School absences due to attending health appointments should not reduce the percentage attendance."

#: submissions/sections.py:315
msgid "q29.child.title"
msgstr "In the past year, how many days have you had off school/home education because of illness related to your diabetes?"

#: submissions/sections.py:316
msgid "q29.parent.title"
msgstr "In the past year, how many days has your child had off school/home education because of illness related to their diabetes?"

#: submissions/sections.py:318
msgid "q29.hint"
msgstr "This could include staying off school at home or include a hospital admission"

#: submissions/sections.py:325
msgid "q30.child.title"
msgstr "Have you ever had to move schools due to difficulties in managing your diabetes?"

#: submissions/sections.py:326
msgid "q30.parent.title"
msgstr "Has your child ever had to move schools due to difficulties in managing their diabetes?"

