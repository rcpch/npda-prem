msgid "Managing Diabetes"
msgstr ""

#: submissions/sections.py:159
msgid "managing_diabetes.introduction"
msgstr "This section asks about your/your child's diabetes treatment. We will use this information to see if children and young people using different diabetes technologies have different experiences at school."

#: submissions/sections.py:166
msgid "q16.child.title"
msgstr "Do you need to administer insulin or monitor blood glucose to manage your diabetes when in school?"

#: submissions/sections.py:167
msgid "q16.parent.title"
msgstr "Does your child need to administer insulin or monitor blood glucose to manage their diabetes when in school?"

